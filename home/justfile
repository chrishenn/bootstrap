# update dotfiles
dot:
    mise bootstrap dotfiles apply -C ~/Projects/bootstrap -y

# mise bootstrap
boot:
    mise bootstrap -C ~/Projects/bootstrap --skip-dirty -y

# sync secrets to age home-level config
ss:
    fnox sync -p age -c ~/.config/fnox/config.toml

# ssh targets
_pty(flag) := if flag == "true" {"-t"} else {""}
_cmd(dir) := f"$(op read op://homelab/svc/bash) && cd {{ dir }} && exec bash -l"

_ssh usr ip port cmd pty='true':
    ssh {{ usr }}@{{ ip }} -p {{ port }} {{ _pty(pty) }} "{{ cmd }}"

[arg("pty", long="pty", short="p")]
rack0 cmd=_cmd("/home/chris/Projects/homelab/rack0") pty='true':
    just _ssh "chris" "192.168.1.70" "22" '{{cmd}}' {{pty}}

[arg("pty", long="pty", short="p")]
rack4 cmd=_cmd("/var/home/chris/Projects/homelab/rack4") pty='true':
    just _ssh "chris" "192.168.1.142" "2200" '{{cmd}}' {{pty}}

[arg("pty", long="pty", short="p")]
vps0 cmd=_cmd("/home/chris/Projects/homelab/vps0") pty='true':
    just _ssh "chris" {{env('VPS0_IP')}} "2200" '{{cmd}}' {{pty}}
