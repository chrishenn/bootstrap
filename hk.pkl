amends "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.7.1/hk@2.7.1#/Builtins.pkl"

steps {
  ["oxfmt"] = Builtins.oxfmt
  ["rumdl_format"] = Builtins.rumdl_format
  ["rumdl"] = Builtins.rumdl
  ["ryl_markdown"] = (Builtins.ryl_markdown) {
    check = new CommandSpec {
      command = new Command { argv = List("ryl", "check", "--markdown", "{{files}}") }
      effect = "read"
    }
    check_diff = new CommandSpec {
      command = new Command { argv = List("ryl", "check", "--diff", "--markdown", "{{files}}") }
      effect = "read"
    }
    check_after_diff = true
    check_list_files = new CommandSpec {
      command = new Command {
        argv = List("ryl", "check", "--list-files", "--markdown", "{{files}}")
      }
      effect = "read"
    }
  }
  ["taplo"] = Builtins.taplo
  ["taplo_format"] = Builtins.taplo_format

  ["shfmt"] = Builtins.shfmt
  ["shellharden"] = Builtins.shellharden
  ["shellcheck"] = (Builtins.shellcheck) {
    check = new CommandSpec {
      command = new Command {
        argv = List("shellcheck", "{{files}}", "-e", "SC2154")
      }
      effect = "read"
    }
    check_diff = new CommandSpec {
      command = new Command {
        argv = List("shellcheck", "--format=diff", "{{files}}", "-e", "SC2154")
      }
      effect = "read"
    }
  }

  ["pkl_format"] = Builtins.pkl_format
  ["pkl"] = Builtins.pkl

  ["check_case_conflict"] = Builtins.check_case_conflict
  ["check_merge_conflict"] = Builtins.check_merge_conflict
  ["check_symlinks"] = Builtins.check_symlinks
  ["fix_smart_quotes"] = Builtins.fix_smart_quotes
  ["mixed_line_ending"] = Builtins.mixed_line_ending
  ["newlines"] = Builtins.newlines
  ["trailing_whitespace"] = Builtins.trailing_whitespace
}
